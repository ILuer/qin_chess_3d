# Cloudflare Pages 响应头配置
# 语法：路径匹配行顶格，头部行缩进两空格
# 参考：https://developers.cloudflare.com/pages/configuration/headers/

# 最小可行 CSP（Task #7 安全基线）：无外部源，全部 'self'。
# - script-src 需 'unsafe-inline'：importmap 与首屏兜底样式为 inline；
# - worker-src 需 blob:：AI module worker（dist/worker.js，ESM worker）；
# - img-src 需 data: blob:：CanvasTexture / 程序化贴图（data: 与 blob: 纹理）。
# 后续若迁移掉 inline script（引入 nonce/hash），可收紧 script-src 移除 'unsafe-inline'。
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self'

# 入口 HTML 不缓存，保证部署后立即生效
/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

# L1 PWA（release-ops-lead）：
# - sw.js / manifest.webmanifest 必须 no-cache：sw.js 是版本切换入口，缓存旧版会导致「改了代码还是旧版」；
#   manifest 变化需立刻被浏览器拾取以更新名称/图标/主题色。
# - /icons/* 走 immutable：与 /vendor/* 同一纪律，icon 内容变更必须改文件名 + 同步 sw.js CACHE_NAME。
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=31536000, immutable

# 源码与样式没有内容哈希文件名，不能用 immutable 长缓存
# 用 must-revalidate + ETag：浏览器每次发条件请求，未变更命中 304（几乎零开销）
/src/*
  Cache-Control: public, max-age=0, must-revalidate

/styles/*
  Cache-Control: public, max-age=0, must-revalidate

# H4 构建产物：main.js / worker.js 为固定文件名（非内容哈希），必须 must-revalidate；
# chunks/* 带内容哈希理论上可 immutable，但统一走 must-revalidate 更稳妥（ETag 304 已足够便宜）。
/dist/*
  Cache-Control: public, max-age=0, must-revalidate

# vendor 是版本锁定的第三方库（three@0.185.0 / r185），内容永不变更。
# 升级走「改目录名 + 改 importmap」，不会原地覆盖，故可安全 immutable 长缓存。
# 1.27MB 的 three.module.js 只在首访下载一次，回访零请求。
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# 说明：本项目已启用最小可行 CSP（见文件顶部 /* 块）。
# importmap 与首屏兜底样式均为 inline，静态托管无法下发 nonce，
# 故 script-src / style-src 放开 'unsafe-inline'；worker-src 放开 blob:（AI module worker）；
# img-src 放开 data: blob:（CanvasTexture）。无外部源，全部 'self'。
# 已启用值：
#   Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self'
