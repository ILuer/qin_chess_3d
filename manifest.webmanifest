{
  "name": "秦风·3D 中国象棋",
  "short_name": "秦风象棋",
  "description": "纯前端 3D 中国象棋，零外部依赖，可离线可添加到主屏。",
  "id": "/qin-chess-3d/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen"],
  "orientation": "any",
  "lang": "zh-CN",
  "dir": "ltr",
  "background_color": "#0a0b0e",
  "theme_color": "#0a0b0e",
  "categories": ["games", "entertainment"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "重新开局",
      "short_name": "重开",
      "url": "./?action=restart",
      "description": "开始一局新对局"
    }
  ],
  "prefer_related_applications": false
}
